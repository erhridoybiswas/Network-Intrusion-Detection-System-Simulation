# Copy this file to .env and adjust as needed.
# NEVER commit your real .env file to GitHub.

IDS_DATABASE_URL=sqlite:///data/ids.db
IDS_API_HOST=127.0.0.1
IDS_API_PORT=5000
IDS_API_DEBUG=true

# Optional: secret key for future authentication work
IDS_SECRET_KEY=change-me-in-production

# Optional: SIEM forwarding endpoint (conceptual integration)
IDS_SIEM_URL=
IDS_SIEM_TOKEN=